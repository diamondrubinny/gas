{
    "name": "diamondrubinny/gas-safety",
    "description": "Dev tooling (PHPCS) for the Gas Safety Manager plugin and theme. Nothing here ships.",
    "type": "project",
    "license": "proprietary",
    "require-dev": {
        "squizlabs/php_codesniffer": "3.13.6",
        "wp-coding-standards/wpcs": "3.4.1",
        "phpcompatibility/phpcompatibility-wp": "2.1.8",
        "dealerdirect/phpcodesniffer-composer-installer": "1.2.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint:php": "find plugins themes tests scripts -name '*.php' -not -path '*/vendor/*' -print0 | xargs -0 -n1 php -l",
        "phpcs": "phpcs",
        "phpcs:style": "phpcs --standard=WordPress-Extra --report=summary --extensions=php plugins/gas-safety-manager themes/gas-safety-theme || true",
        "test:unit": [
            "php tests/bi-token-test.php plugins/gas-safety-manager",
            "php tests/csv-injection-test.php plugins/gas-safety-manager",
            "php tests/csv-reader-test.php plugins/gas-safety-manager"
        ]
    }
}
